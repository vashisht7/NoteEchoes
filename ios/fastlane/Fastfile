default_platform(:ios)

platform :ios do
  desc "Push a new beta build to Apple TestFlight"
  lane :beta do
    # 1. Bump build number automatically based on timestamp
    increment_build_number(
      build_number: Time.now.to_i.to_s,
      xcodeproj: "Runner.xcodeproj"
    )

    # 2. Build iOS release IPA
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      clean: true,
      output_directory: "./build/ipa",
      output_name: "NoteEchoes.ipa"
    )

    # 3. Upload directly to Apple TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
